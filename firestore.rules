rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each student can read and write only their own record.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','email','photo','xp','level','pages','visited','badges','books','visits','firstSeen','lastSeen'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 100000;
    }

    // Leaderboard: any signed-in student can read; each student writes only their own row.
    match /board/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','form','pct','xp','updated'])
        && request.resource.data.form in ['S4','S5','S6']
        && request.resource.data.pct is int && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 100000
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The teacher can read every record. Replace the address below with your own Google account.
    match /users/{uid} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['andrewlamict@gmail.com'];
    }
  }
}
